{
  "name": "@daystar7777/mdok",
  "version": "0.1.4",
  "description": "Markdown OK — pretty CLI viewer + LLM analysis for .md files (BYOK)",
  "type": "module",
  "bin": {
    "mdok": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test src/*.test.ts",
    "test:mass": "node --import tsx --test tests/*.test.ts",
    "test:all": "npm test && npm run test:mass",
    "prepack": "npm run build && npm run test:all",
    "start": "node dist/index.js",
    "pkg": "node scripts/pkg-build.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "markdown",
    "cli",
    "llm",
    "viewer"
  ],
  "license": "MIT",
  "author": "daystar7777",
  "homepage": "https://mdok.net",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "docs/qr-transfer.md",
    "README.md",
    "README.ko.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/daystar7777/mdok-cli.git"
  },
  "bugs": {
    "url": "https://github.com/daystar7777/mdok-cli/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^7.1.1",
    "marked": "^12.0.0",
    "marked-terminal": "^7.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "jsqr": "^1.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0"
  }
}
