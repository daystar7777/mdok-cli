{
  "name": "mdok-desktop",
  "version": "0.1.0",
  "description": "mdok desktop shell — Electron + xterm.js running the mdok TUI",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc && node scripts/copy-assets.mjs",
    "stage-bin": "node scripts/stage-bin.mjs",
    "rebuild": "electron-rebuild",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "electron": "^35.0.0",
    "node-pty": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.6.0",
    "typescript": "^5.6.0"
  }
}
